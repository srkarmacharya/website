---
import type { Item } from '../lib/studyplan';
interface Props { it: Item }
const { it } = Astro.props;
---
<div class="plan-row">
  <span class="wk small muted">{it.weekLabel}</span>
  <div class="body">
    <p class="topic">{it.topic}</p>
    {it.links.length > 0 && (
      <p class="meta">{it.links.map((l) => <a class="accent-link" href={l.url} rel="noopener">{l.label}</a>)}</p>
    )}
    {it.note && <p class="note">{it.note}</p>}
  </div>
</div>

<style>
  .plan-row { display: grid; grid-template-columns: 96px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .wk { padding-top: 3px; font-variant-numeric: tabular-nums; }
  p { margin: 0; }
  .topic { font-size: 16px; }
  .meta { font-size: 13px; display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 2px; }
  .note { font-size: 13px; color: var(--muted); font-style: italic; margin-top: 4px; }
  @media (max-width: 560px) {
    .plan-row { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
